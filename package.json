{
	"name": "voice-channel-template",
	"version": "0.0.1",
	"description": "Template voice channel for Front",
	"license": "ISC",
	"scripts": {
		"build:client": "esbuild src/public/index.tsx --bundle --outfile=dist/public/bundle.js",
