		"jsonwebtoken": "^8.5.1",
		"moment": "^2.29.3",
		"needle": "^3.1.0",
		"react": "^19.2.5",
		"react-dom": "^19.2.5"
	},
	"devDependencies": {
		"@types/express": "^4.17.13",
		"@types/needle": "^2.5.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.0.0",
		"@typescript-eslint/eslint-plugin": "^5.3.1",
		"@typescript-eslint/parser": "^5.3.1",
		"esbuild": "^0.25.0",
		"eslint": "^8.2.0",
		"sandbox": "^0.8.6",
		"ts-node": "^7.0.1",
		"typescript": "^3.2.2"
